logging {
  level  = "info"
  format = "logfmt"
}

prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.victoria.receiver]
}

prometheus.scrape "node_exporter" {
  targets = [
    {
      "__address__" = "node-exporter:9100",
      "job"         = "node",
      "instance"    = "cortex-host",
    },
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.victoria.receiver]
}

prometheus.scrape "victoriametrics" {
  targets = [
    {
      "__address__" = "victoriametrics:8428",
      "job"         = "victoriametrics",
    },
  ]
  metrics_path    = "/metrics"
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.victoria.receiver]
}

prometheus.remote_write "victoria" {
  endpoint {
    url = "http://victoriametrics:8428/api/v1/write"
  }
}

// Metrics-first default: no Docker socket and no host log mounts.
// To ship logs into VictoriaLogs, add a source (for example loki.source.file
// with an operator-managed path) and forward to this write endpoint:
//
// loki.write "victoria_logs" {
//   endpoint {
//     url = "http://victorialogs:9428/insert/loki/api/v1/push"
//   }
// }
