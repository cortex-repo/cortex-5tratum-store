logging {
  level  = "info"
  format = "logfmt"
}

prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.victoria.receiver]
}

prometheus.scrape "node_exporter" {
  targets = [
    {
      "__address__" = "node-exporter:9100",
      "job"         = "node",
      "instance"    = "cortex-host",
    },
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.victoria.receiver]
}

prometheus.scrape "victoriametrics" {
  targets = [
    {
      "__address__" = "victoriametrics:8428",
      "job"         = "victoriametrics",
    },
  ]
  metrics_path    = "/metrics"
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.victoria.receiver]
}

prometheus.remote_write "victoria" {
  endpoint {
    url = "http://victoriametrics:8428/api/v1/write"
  }
}

// Collect stdout/stderr from every Docker container via the Docker API,
// then ship to VictoriaLogs (Loki-compatible push API).
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = {"job" = "docker"}
  forward_to = [loki.write.victoria_logs.receiver]
}

loki.write "victoria_logs" {
  endpoint {
    url = "http://victorialogs:9428/insert/loki/api/v1/push"
  }
}
