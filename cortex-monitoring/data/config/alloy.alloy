logging {
  level  = "warn"
  format = "logfmt"
}

prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.victoria.receiver]
}

prometheus.scrape "node_exporter" {
  targets = [
    {
      "__address__" = "node-exporter:9100",
      "job"         = "node",
      "instance"    = "cortex-host",
    },
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.victoria.receiver]
}

prometheus.scrape "victoriametrics" {
  targets = [
    {
      "__address__" = "victoriametrics:8428",
      "job"         = "victoriametrics",
    },
  ]
  metrics_path    = "/metrics"
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.victoria.receiver]
}

prometheus.remote_write "victoria" {
  endpoint {
    url = "http://victoriametrics:8428/api/v1/write"
  }
}

// Collect stdout/stderr from every Docker container via the Docker API,
// then ship to VictoriaLogs (Loki-compatible push API).
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = {"job" = "docker"}
  forward_to = [loki.write.victoria_logs.receiver]
}

loki.write "victoria_logs" {
  endpoint {
    url = "http://victorialogs:9428/insert/loki/api/v1/push"
  }
}

// Sharelogs are JSON without msg/_msg. Tell VictoriaLogs to use workername
// as the message after it unpacks the Loki line JSON.
loki.write "victoria_logs_ckpool" {
  endpoint {
    url = "http://victorialogs:9428/insert/loki/api/v1/push?_msg_field=workername,_msg"
  }
}

// Axe BCH pool logs (ckpool + sharelogs under pool/www).
// After log cleanup the tree is smaller — poll more often so dashboards
// don't show multi-minute gaps, while still ignoring stale files.
local.file_match "axebch_pool" {
  path_targets = [
    {
      "__path__"  = "/host/axebch-pool-www/ckpool.log*",
      "job"       = "ckpool",
      "log_type"  = "ckpool",
      "coin"      = "bch",
      "pool_app"  = "axebch",
    },
    {
      "__path__"  = "/host/axebch-pool-www/**/*.sharelog",
      "job"       = "ckpool",
      "log_type"  = "sharelog",
      "coin"      = "bch",
      "pool_app"  = "axebch",
    },
  ]
  sync_period       = "20s"
  ignore_older_than = "6h"
}

loki.source.file "axebch_pool" {
  targets       = local.file_match.axebch_pool.targets
  forward_to    = [loki.process.axebch_pool.receiver]
  // Heavy historical sharelogs — start at EOF on first discover.
  // Delete Alloy positions under APP_DATA_DIR/alloy to re-ingest if needed.
  tail_from_end = true

  file_watch {
    min_poll_frequency = "1s"
    max_poll_frequency = "5s"
  }
}

loki.process "axebch_pool" {
  forward_to = [loki.write.victoria_logs_ckpool.receiver]

  // Promote low-cardinality fields to stream labels for filtering.
  stage.match {
    selector = "{log_type=\"sharelog\"}"

    stage.json {
      expressions = {
        result = "result",
        agent  = "agent",
      }
    }

    stage.labels {
      values = {
        result = "",
        agent  = "",
      }
    }
  }
}
